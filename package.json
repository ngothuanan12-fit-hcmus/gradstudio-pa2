{
  "name": "gradstudio",
  "private": true,
  "type": "module",
  "description": "GradStudio (CSC13008): React client in client/, mock API in mock/, contract in docs/api/. Root scripts are the gates.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && npm --prefix client run lint",
    "test": "node --test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "3.10.1"
  }
}
